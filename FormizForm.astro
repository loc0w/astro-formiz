---
export interface Props {
  /** Your Formiz access key. Defaults to PUBLIC_FORMIZ_KEY from your env. */
  accessKey?: string;
  /** Submit with fetch and keep the visitor on the page. Default: false. */
  ajax?: boolean;
  /** Extra classes for the <form> element. */
  class?: string;
}

const {
  accessKey = import.meta.env.PUBLIC_FORMIZ_KEY,
  ajax = false,
  class: className,
} = Astro.props;

if (!accessKey) {
  throw new Error(
    'astro-formiz: no access key. Pass accessKey, or set PUBLIC_FORMIZ_KEY in your .env. ' +
      'You can find the key on the Overview page of your Formiz dashboard.'
  );
}

const ENDPOINT = 'https://api.formiz.app/submit';
---

<form
  method="POST"
  action={ENDPOINT}
  class={className}
  data-formiz-ajax={ajax ? '' : undefined}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <slot />
</form>

{
  ajax && (
    <script is:inline>
      document.querySelectorAll('form[data-formiz-ajax]').forEach((form) => {
        if (form.dataset.formizBound) return;
        form.dataset.formizBound = 'true';

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          form.dataset.formizState = 'sending';
          form.dispatchEvent(new CustomEvent('formiz:sending', { bubbles: true }));

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
            });
            const result = await response.json();

            if (result.success) {
              form.reset();
              form.dataset.formizState = 'sent';
              form.dispatchEvent(
                new CustomEvent('formiz:sent', { bubbles: true, detail: result })
              );
            } else {
              form.dataset.formizState = 'error';
              form.dispatchEvent(
                new CustomEvent('formiz:error', { bubbles: true, detail: result })
              );
            }
          } catch (error) {
            form.dataset.formizState = 'error';
            form.dispatchEvent(
              new CustomEvent('formiz:error', { bubbles: true, detail: error })
            );
          }
        });
      });
    </script>
  )
}
